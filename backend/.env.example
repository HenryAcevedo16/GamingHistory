# Gaming History Studio - backend configuration
# Copy this file to backend/.env and adjust if needed.

# GHS_DATABASE_URL=sqlite:///C:/absolute/path/to/studio.db
# GHS_PLUGINS_DIR=C:/absolute/path/to/plugins
# GHS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# GHS_COMMAND_TIMEOUT_SECONDS=15
# GHS_WORKSPACE_DIR=C:/absolute/path/to/authorized-media
# GHS_UPLOAD_MAX_BYTES=2147483648
# Optional initial folder (outside the repo and workspace). The UI can override it.
# GHS_BACKUP_DIR=D:/GamingHistoryBackups
# GHS_BACKUP_MAX_BYTES=21474836480
# GHS_AI_TIMEOUT_SECONDS=60
# GHS_AI_MODEL=sonnet
# GHS_OPENCODE_SERVER_URL=http://127.0.0.1:4096
# GHS_OPENCODE_SERVER_PASSWORD=
# GHS_OPENCODE_MODEL=  # Optional provider/model ID from the Studio model list

# Plugin-specific endpoints (optional, discovered by diagnostics)
# Set these in the backend process environment (PowerShell: $env:NAME='value').
# VECTCUT_ENDPOINT=http://127.0.0.1:9000
# VECTCUT_ROOT=E:/VectCutAPI
# CAPCUT_DRAFTS_DIR=<local folder confirmed in CapCut Global Settings>
# DESCRIPT_MCP_ENDPOINT=
# DESCRIPT_API_TOKEN=

# DaVinci Resolve scripting (optional; Resolve's own installer normally sets these)
# RESOLVE_SCRIPT_API=
# RESOLVE_SCRIPT_LIB=
